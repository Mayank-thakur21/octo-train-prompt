# Prompt Engineering Studio - configuration
#
# Copy this file to .env and adjust it. docker compose reads .env for the backend service;
# for local development the backend reads .env from the directory it is started in.
# Every value below is the built-in default, so you only need to keep the lines you change.
# Invalid values stop the backend at startup with a message naming the setting.

# ---------------------------------------------------------------------------------------------
# Model providers
# Leave a key empty to disable that provider. With no key at all the app runs in demo mode
# using the offline demo models.
# ---------------------------------------------------------------------------------------------

# Enables the Anthropic (Claude) models.
ANTHROPIC_API_KEY=
# Enables the OpenAI models.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (Chat Completions with max_completion_tokens). Empty = api.openai.com.
OPENAI_BASE_URL=
# Enables the Google Gemini models.
GEMINI_API_KEY=

# Catalog entries for OpenAI and Gemini, comma separated. Each entry is "id" or "id=Display Name".
OPENAI_MODELS=gpt-5.5,gpt-5.4-mini,gpt-4.1-mini
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-pro-preview
# OpenAI model id prefixes that accept a temperature (other OpenAI models ignore it with a warning).
OPENAI_TEMPERATURE_PREFIXES=gpt-4,gpt-3.5,chatgpt-4o
# Output token limit assumed for every OpenAI / Gemini catalog entry.
OPENAI_MAX_OUTPUT_TOKENS=32768
GEMINI_MAX_OUTPUT_TOKENS=65536

# List the offline demo models (demo-concise, demo-verbose). They need no key.
DEMO_ENABLED=true
# Delay between streamed demo chunks in milliseconds (0..1000).
DEMO_STREAM_DELAY_MS=20

# Preferred default model (must be a catalog id). When its provider has no key, the first
# available model is used instead.
DEFAULT_MODEL=claude-opus-5-5
# Default model for LLM-judge assertions. Empty = the effective default model.
JUDGE_MODEL=
# max_tokens for judge calls.
JUDGE_MAX_TOKENS=2048

# ---------------------------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------------------------

# SQLAlchemy async database URL. docker compose overrides it with sqlite+aiosqlite:////app/data/studio.db.
DATABASE_URL=sqlite+aiosqlite:///./data/studio.db

# ---------------------------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------------------------

# Accepted X-API-Key values, comma separated, each at least 16 characters.
# EMPTY = OPEN API: anyone who can reach the server can use your provider keys.
# Set this whenever the server is reachable by anyone but you.
API_KEYS=
# Browser origins allowed to call the API directly (the bundled frontend uses the same origin).
# "*" is only used when you set it explicitly.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Peers (IPs or CIDRs) allowed to set X-Forwarded-For. docker compose sets the frontend proxy, 172.28.0.10.
TRUSTED_PROXIES=

# Rate limiting (limits library syntax; join several limits with ";", e.g. 30/minute;500/day).
RATE_LIMIT_ENABLED=true
# Storage for the counters. memory:// is per process; redis://host:6379 needs the redis package installed.
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_RUNS=30/minute
RATE_LIMIT_COMPARE=10/minute
RATE_LIMIT_EVALS=10/minute
# Token estimates and template rendering.
RATE_LIMIT_TOKENS=120/minute
# Export and import.
RATE_LIMIT_DATA=10/minute
# Failed API-key attempts per client IP.
RATE_LIMIT_AUTH_FAILURES=10/minute

# Request body limits in bytes (2 MiB, and 5 MiB for /api/import).
MAX_BODY_BYTES=2097152
IMPORT_MAX_BYTES=5242880

# ---------------------------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------------------------

MAX_PROMPT_CHARS=100000
MAX_SYSTEM_CHARS=50000
# Rendered system + user prompt.
MAX_RENDERED_CHARS=200000
MAX_VARIABLES=50
MAX_VARIABLE_VALUE_CHARS=50000
# Global cap on max_tokens, and the default when a request leaves max_tokens empty.
MAX_OUTPUT_TOKENS=16384
DEFAULT_MAX_TOKENS=4096

MAX_COMPARE_VARIANTS=4
MAX_COMPARE_MODELS=4
MAX_COMPARE_CELLS=12
COMPARE_CONCURRENCY=4
# Overall deadline for one comparison, in seconds.
COMPARE_TOTAL_TIMEOUT_SECONDS=180

MAX_CASES_PER_SUITE=100
MAX_ASSERTIONS_PER_CASE=20
MAX_EVAL_MODELS=4
# Provider calls per evaluation: cases x models, plus one judge call per LLM judge
# assertion and model.
MAX_EVAL_CALLS=200
EVAL_CONCURRENCY=4

MAX_TAGS_PER_PROMPT=10
MAX_VERSIONS_PER_PROMPT=200
# History retention: the oldest rows beyond this count are deleted.
HISTORY_MAX_ROWS=5000

# ---------------------------------------------------------------------------------------------
# Provider calls
# ---------------------------------------------------------------------------------------------

# Deadline for one provider call or stream, in seconds (1..600).
REQUEST_TIMEOUT_SECONDS=120
# Retries done by the provider SDKs before a response starts (0..5).
PROVIDER_MAX_RETRIES=2
# Concurrent provider calls across the whole server.
PROVIDER_CONCURRENCY=16
# Keepalive comment interval for streaming responses, in seconds.
SSE_KEEPALIVE_SECONDS=15

# ---------------------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------------------

# Serve Swagger UI at /api/docs and the schema at /api/openapi.json.
DOCS_ENABLED=true
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# text or json (docker compose sets json).
LOG_FORMAT=text
